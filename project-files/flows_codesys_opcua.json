    {
        "id": "66e5c4e77ae3f0b4",
        "type": "function",
        "z": "47918737585505b7",
        "name": "Naming Function",
        "func": "// Batch_State number → readable name + color\nconst names = [\"IDLE\", \"DOSING\", \"MIXING\", \"DISCHARGING\", \"COMPLETE\", \"FAULT\"];\n\n// Guard: only accept a real number 0-5\nconst state = Number(msg.payload);\nif (Number.isInteger(state) && state >= 0 && state < names.length) {\n    msg.payload = names[state];\n    msg.color = state === 5 ? \"red\" : (state === 0 ? \"grey\" : \"green\");\n} else {\n    msg.payload = \"?\";\n    msg.color = \"grey\";\n}\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
