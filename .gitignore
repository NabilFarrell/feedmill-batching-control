# CODESYS build artifacts and machine-specific settings
# NOTE: `*.opt` contains the Windows username and hostname. Never commit.
*.opt
*.compileinfo
*.bootinfo
*.bootinfo_guids
*.precompilecache
*.cache
*.~u
*.lck
*.backup
*.bak
*~u

# Ignition
*.stackstate
*.scsnapshot
*.log

# Node-RED (v1 layer, kept in repo — ignore only local runtime state)
node_modules/
.nodered/

# OS / editor
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
